# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage Paths
CHROMA_DIR=./chroma_data
SQLITE_PATH=./app_data/app.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Research Defaults
DEFAULT_DEPTH=normal
MAX_SOURCES_QUICK=5
MAX_SOURCES_NORMAL=10
MAX_SOURCES_DEEP=20
MAX_RETRIEVAL_LOOPS=2

# Semantic Cache
CACHE_SIMILARITY_THRESHOLD=0.92

# Rate Limits (Semantic Scholar: 100 req/5min)
SEMANTIC_SCHOLAR_RATE_LIMIT=100
